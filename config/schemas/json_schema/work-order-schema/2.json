{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reception and Work Order Request",
  "description": "Data contract for importing labware and creating a work order for a selected subset of its samples.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "description": "Integration request metadata and callback configuration.",
      "properties": {
        "external_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier used by the calling integration to correlate this request."
        },
        "request_type": {
          "const": "reception_and_work_order",
          "description": "Combined labware reception and work-order request type."
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the request payload schema."
        }
      },
      "required": [
        "external_id",
        "request_type",
        "schema_version"
      ],
      "additionalProperties": false
    },
    "work_order": {
      "type": "object",
      "description": "Work-order details, requested sample selection, and labware to import.",
      "properties": {
        "external_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier used by the calling integration to correlate this work order."
        },
        "work_order_type": {
          "type": "string",
          "minLength": 1,
          "description": "Requested work-order type, such as library_preparation."
        },
        "requested_by": {
          "type": "string",
          "minLength": 1,
          "description": "Login or identifier of the requester."
        },
        "project_uuid": {
          "$ref": "#/$defs/uuid"
        },
        "requested_receptacle_uuids": {
          "type": "array",
          "description": "UUIDs of the receptacles in the imported labware that are included in this work order. Receptacles (and samples) present in labware but not listed here are imported without being requested.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "options": {
          "type": "object",
          "description": "Work-order-specific options. Keys and value types are defined by the work_order_type.",
          "properties": {
            "fragment_size_required_from": {
              "type": "integer",
              "minimum": 1,
              "description": "Minimum fragment size"
            },
            "fragment_size_required_to": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum fragment size"
            },
            "bait_library_name": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the bait library"
            },
            "library_type": {
              "type": "string",
              "minLength": 1,
              "description": "Type of library"
            },
            "requested_flowcell_type": {
              "type": "string",
              "minLength": 1,
              "description": "Type of flowcell"
            },
            "pre_capture_group": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Pre-capture group"
            },
            "pre_capture_plex_level": {
              "type": "integer",
              "minimum": 1,
              "description": "Pre-capture plex level"
            },
            "gigabases_expected": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Expected number of gigabases"
            },
            "primer_panel_name": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the primer panel"
            },
            "priority": {
              "enum": [
                "None",
                "Low",
                "Medium",
                "High"
              ],
              "description": "Priority of the work order"
            },
            "read_length": {
              "type": "integer",
              "minimum": 1,
              "description": "Read length"
            },
            "number_of_lanes": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of lanes"
            },
            "comments": {
              "type": "string",
              "description": "Comments for the work order"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "external_id",
        "work_order_type",
        "requested_by",
        "project_uuid",
        "requested_receptacle_uuids",
        "options"
      ],
      "additionalProperties": false
    },
    "labware": {
      "type": "array",
      "description": "Labware and its receptacles to import. This describes the physical contents, not which samples are requested.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/labware"
      }
    }
  },
  "required": [
    "request",
    "labware"
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "labware": {
      "type": "object",
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "barcode": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "plate96",
            "plate384",
            "tube"
          ],
          "description": "Labware type enum value"
        },
        "retention_instruction": {
          "enum": [
            "destroy_after_2_years",
            "return_to_customer_after_2_years",
            "long_term_storage"
          ]
        },
        "receptacles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receptacle"
          }
        }
      },
      "required": [
        "uuid",
        "barcode",
        "type",
        "retention_instruction",
        "receptacles"
      ],
      "additionalProperties": false
    },
    "receptacle": {
      "type": "object",
      "properties": {
        "position": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Position of this receptacle within the labware, such as A1. Leave null if not applicable, such as for tubes."
        },
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sample"
          }
        }
      },
      "required": [
        "position",
        "uuid",
        "samples"
      ],
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "study_uuid": {
          "$ref": "#/$defs/uuid"
        },
        "sanger_sample_id": {
          "type": "string",
          "minLength": 1
        },
        "supplier_sample_name": {
          "type": "string",
          "minLength": 1
        },
        "bioscan_supplier_name": {
          "type": "string",
          "minLength": 1
        },
        "control_type": {
          "enum": [
            "negative",
            "positive",
            "pcr negative",
            "pcr positive",
            "lysate negative"
          ],
          "description": "Control classification, when the sample is a control."
        },
        "bioscan_control_type": {
          "enum": [
            "pcr positive",
            "pcr negative",
            "lysate negative"
          ]
        },
        "i7": {
          "type": "string",
          "minLength": 1
        },
        "i5": {
          "type": "string",
          "minLength": 1
        },
        "tag_group": {
          "type": "string",
          "minLength": 1
        },
        "tag_index": {
          "type": "integer",
          "minimum": 1
        },
        "tag2_group": {
          "type": "string",
          "minLength": 1
        },
        "tag2_index": {
          "type": "integer",
          "minimum": 1
        },
        "chromium_tag_group": {
          "type": "string",
          "minLength": 1
        },
        "chromium_tag_well": {
          "type": "string",
          "minLength": 1
        },
        "library_type": {
          "type": "string",
          "minLength": 1
        },
        "library_type_long_read": {
          "type": "string",
          "minLength": 1
        },
        "dual_index_tag_set": {
          "type": "string",
          "minLength": 1
        },
        "dual_index_tag_well": {
          "type": "string",
          "minLength": 1
        },
        "reference_genome": {
          "type": "string",
          "minLength": 1
        },
        "insert_size_from": {
          "type": "integer",
          "minimum": 1
        },
        "insert_size_to": {
          "type": "integer",
          "minimum": 1
        },
        "donor_id": {
          "type": "string",
          "minLength": 1
        },
        "primer_panel": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "no_priority",
            "backlog",
            "surveillance",
            "priority"
          ]
        }
      },
      "required": [
        "uuid",
        "study_uuid",
        "sanger_sample_id",
        "supplier_sample_name"
      ],
      "additionalProperties": false
    }
  }
}