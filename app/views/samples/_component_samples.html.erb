<%= panel do %>
  <h3>
    Component Samples <%= counter_badge @component_samples.count %>
  </h3>

  <table width='100%'>
    <thead>
      <tr>
        <th width='70%'></th>
        <% if @component_tags.any? %>
          <th>Tag</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @component_samples.each do |cs| %>
        <tr>
          <td>
            <%= link_to "Sample #{cs.id}", sample_path(cs) %>
            <%= cs.name || 'Un-named' %>
          </td>
          <% if @component_tags.any? %>
            <td>
              <% if (tag = @component_tags[cs.id]) %>
                <%= render partial: 'shared/tag_info', locals: { tag: } %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div style="margin-top: 25px;">
    <%= pagination @component_samples %>
  </div>
<% end %>
<%  %>